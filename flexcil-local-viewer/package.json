{
  "name": "flexcil-local-viewer",
  "private": true,
  "version": "1.2.1",
  "description": "Local Flexcil backup PDF viewer with Electron launcher",
  "author": "Jan",
  "repository": {
    "type": "git",
    "url": "https://github.com/janptn/flexcil-backup-viewer.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build",
    "build:server": "node -e \"require('fs').accessSync('launcher/server.cjs'); console.log('server launcher ready')\"",
    "build:electron": "npm run build:web && npm run build:server",
    "electron:dev": "npm run build:electron && electron .",
    "dist:win": "npm run build:electron && electron-builder --win nsis",
    "prepare:icons": "node scripts/prepare-icons.cjs",
    "set:exe:icon": "node scripts/set-exe-icon.cjs",
    "build:server:exe": "pkg package.json --targets node18-win-x64 --output release/Flexcil-Local-Viewer-Server.exe",
    "build:gui:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-gui-wrapper.ps1",
    "build:exe": "npm run prepare:icons && npm run build && npm run build:server:exe && npm run build:gui:exe && npm run set:exe:icon",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.576.0",
    "pako": "^2.1.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "png-to-ico": "^2.1.8",
    "nexe": "^5.0.0-beta.4",
    "node-resourcehacker": "^1.2.1",
    "pkg": "^5.8.1",
    "rcedit": "^4.0.1",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^5.4.11"
  },
  "pkg": {
    "assets": [
      "dist/**/*",
      "launcher/logo.ico"
    ]
  },
  "build": {
    "appId": "com.flexcil.localviewer.launcher",
    "productName": "Flexcil Local Viewer",
    "asar": true,
    "directories": {
      "output": "release/electron"
    },
    "files": [
      "dist/**/*",
      "launcher/server.cjs",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "launcher/server.cjs",
        "to": "launcher/server.cjs"
      },
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "launcher/logo.ico",
      "artifactName": "Flexcil-Local-Viewer-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "launcher/logo.ico",
      "uninstallerIcon": "launcher/logo.ico",
      "installerHeaderIcon": "launcher/logo.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "janptn",
        "repo": "flexcil-backup-viewer"
      }
    ]
  }
}
